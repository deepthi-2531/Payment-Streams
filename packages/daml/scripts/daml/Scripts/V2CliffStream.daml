-- | V2 Cliff vesting stream on live TestNet — ONE multi-leg Allocation.
--
-- ## Cliff schedule
--
--   30-day cliff, then linear release of 1000 v2-cliff-stream-token over
--   3 post-cliff periods. The entire schedule is encoded as multiple
--   `TransferLegSide`s in a single committed Allocation.
--
--   leg 1 (cliff period @ day 30):  400 → Swapuser
--   leg 2 (day 45):                  200 → Swapuser
--   leg 3 (day 60):                  400 → Swapuser
--                                    ---
--   total                            1000
--
-- The cliff "non-linearity" is expressed in the leg amounts directly:
--   * The first 30 days (pre-cliff) have NO leg — recipient gets nothing
--   * Day 30 leg is the cliff release (the largest single chunk)
--   * Subsequent legs are linear chunks of the remainder
--
-- Settling these legs individually per period is the natural V2 next step
-- (via Allocation_Settle with extraTransferLegSides matching the current
-- period's leg id). That path is currently blocked by Canton package-
-- version routing on this participant (see task #128). The committed
-- Allocation itself IS a real on-ledger V2 contract with the cliff
-- schedule encoded — that's the demonstration this script delivers.
module Scripts.V2CliffStream where

import Daml.Script
import DA.Time (time, addRelTime, days)
import DA.Date (date, Month(..))
import qualified DA.TextMap as TextMap

import qualified Splice.Api.Token.HoldingV2 as V2
import qualified Splice.Api.Token.AllocationV2 as Alloc
import qualified Splice.Api.Token.AllocationInstructionV2 as AInstr
import qualified Splice.Api.Token.MetadataV1 as Meta

import Splice.Testing.Tokens.TestTokenV2 (TokenRules(..))
import Splice.Testing.Tokens.TestTokenV2.Holding (Token(..))

resolveParty : Text -> Script Party
resolveParty pid = case partyFromText pid of
  None -> abort ("Could not resolve party from text: " <> pid)
  Some p -> pure p

-- | Build a TransferLegSide for one cliff-period leg.
mkLegSide : Party -> Text -> Decimal -> Text -> Alloc.TransferLegSide
mkLegSide recipient legId amt instrId =
  let recipientAccount = V2.Account with owner = Some recipient; provider = None; id = ""
  in Alloc.TransferLegSide with
        transferLegId = legId
        side = Alloc.SenderSide
        otherside = recipientAccount
        amount = amt
        instrumentId = instrId
        meta = Meta.emptyMetadata

runV2Cliff : Script ()
runV2Cliff = do
  admin <- resolveParty "admin::<participant-fingerprint>"
  swapuser <- resolveParty "Swapuser::<participant-fingerprint>"
  debug "=== V2 cliff stream: ONE multi-leg Allocation on TestNet ==="

  let instrumentIdText = "v2-cliff-stream-token"
      instrumentId = V2.InstrumentId with admin = admin; id = instrumentIdText
      adminAccount = V2.Account with owner = Some admin; provider = None; id = ""
      adminHolding = V2.HoldingView with
        account = adminAccount
        instrumentId = instrumentId
        amount = 1000.0
        lock = None
        meta = Meta.emptyMetadata

  rulesCid <- submit admin $ createCmd (TokenRules with admin)
  debug ("TokenRules cid: " <> show rulesCid)

  holdingCid <- submit admin $ createCmd (Token with holding = adminHolding)
  debug ("admin funding holding cid (1000 units): " <> show holdingCid)

  now <- getTime

  -- Cliff schedule: 3 post-cliff release legs encoded in the Allocation.
  -- Pre-cliff periods have no leg (= no release; nothing for those periods
  -- in the on-ledger spec).
  let cliffSchedule =
        [ mkLegSide swapuser "cliff-day-30"  400.0 instrumentIdText  -- cliff release
        , mkLegSide swapuser "linear-day-45" 200.0 instrumentIdText  -- linear chunk
        , mkLegSide swapuser "linear-day-60" 400.0 instrumentIdText  -- final chunk
        ]

      spec = Alloc.AllocationSpecification with
        admin = admin
        authorizer = adminAccount
        transferLegSides = cliffSchedule
        settlementDeadline = Some (now `addRelTime` days 90)
        nextIterationFunding = None  -- non-iterated; legs are the full schedule
        committed = True              -- lock 1000 until executor settles per period
        meta = Meta.emptyMetadata

      settlementInfo = Alloc.SettlementInfo with
        executors = [admin]
        id = "v2-cliff-stream-001"
        cid = None
        meta = Meta.emptyMetadata

      factoryCid = toInterfaceContractId @AInstr.AllocationFactory rulesCid
      rulesAnyCid : ContractId Meta.AnyContract = coerceContractId rulesCid
      tokenRulesCtx = TextMap.fromList
        [ ("testTokenV2/tokenRules", Meta.AV_ContractId rulesAnyCid) ]

  debug "=== exercising AllocationFactory_Allocate with cliff-shaped legs ==="

  result <- submit admin $ exerciseCmd factoryCid AInstr.AllocationFactory_Allocate with
    settlement = settlementInfo
    allocation = spec
    requestedAt = now
    inputHoldingCids = [toInterfaceContractId @V2.Holding holdingCid]
    extraArgs = Meta.ExtraArgs with
      context = Meta.ChoiceContext with values = tokenRulesCtx
      meta = Meta.emptyMetadata
    actors = [admin]

  case result.output of
    AInstr.AllocationInstructionResult_Completed allocCid -> do
      debug ("🎉 CLIFF Allocation cid: " <> show allocCid)
      debug ""
      debug "  This single Allocation contract encodes the cliff schedule:"
      debug "    leg 1: cliff-day-30   → 400 to Swapuser"
      debug "    leg 2: linear-day-45  → 200 to Swapuser"
      debug "    leg 3: linear-day-60  → 400 to Swapuser"
      debug "    total locked:           1000 (committed=True)"
      debug ""
      debug "  Each leg is settled per accrual period via Allocation_Settle"
      debug "  (currently blocked by Canton package-version routing — task #128)."
      debug ""
      debug "  This Allocation contract IS the V2 cliff stream on TestNet."
    AInstr.AllocationInstructionResult_Pending instrCid ->
      debug ("⏳ AllocationInstruction cid (needs further accept): " <> show instrCid)
    AInstr.AllocationInstructionResult_Failed ->
      abort "AllocationFactory_Allocate returned Failed"

-- | Attempt to settle the cliff allocation (atomic — settles all 3 legs at once
-- since nextIterationFunding=None means non-iterated single shot).
--
-- This will transfer 400+200+400 = 1000 to Swapuser in one transaction.
-- If the package-version downgrade error (task #128) does NOT fire here,
-- the cliff Allocation completes and Swapuser receives a 1000-unit HoldingV2.
settleCliffAllocation : ContractId Alloc.Allocation -> ContractId TokenRules -> Script ()
settleCliffAllocation allocCid rulesCid = do
  admin <- resolveParty "admin::<participant-fingerprint>"
  debug "=== Attempt Allocation_Settle on cliff allocation (all legs atomic) ==="

  let rulesAnyCid : ContractId Meta.AnyContract = coerceContractId rulesCid
      tokenRulesCtx = TextMap.fromList
        [ ("testTokenV2/tokenRules", Meta.AV_ContractId rulesAnyCid) ]

  result <- submit admin $ exerciseCmd allocCid Alloc.Allocation_Settle with
    actors = [admin]
    extraTransferLegSides = []
    nextIterationFunding = None
    extraArgs = Meta.ExtraArgs with
      context = Meta.ChoiceContext with values = tokenRulesCtx
      meta = Meta.emptyMetadata

  debug ("Settle output: " <> show result.output)
  case result.output of
    Alloc.AllocationResult_Settled nextOpt ->
      debug ("🎉 Cliff allocation SETTLED. 1000 units → Swapuser. nextOpt=" <> show nextOpt)
    _ -> debug ("Unexpected output: " <> show result.output)

-- | One-shot variant: create the cliff allocation AND immediately settle it.
runV2CliffAndSettle : Script ()
runV2CliffAndSettle = do
  admin <- resolveParty "admin::<participant-fingerprint>"
  swapuser <- resolveParty "Swapuser::<participant-fingerprint>"

  let instrumentIdText = "v2-cliff-stream-settle-token"
      instrumentId = V2.InstrumentId with admin = admin; id = instrumentIdText
      adminAccount = V2.Account with owner = Some admin; provider = None; id = ""
      adminHolding = V2.HoldingView with
        account = adminAccount
        instrumentId = instrumentId
        amount = 1000.0
        lock = None
        meta = Meta.emptyMetadata

  rulesCid <- submit admin $ createCmd (TokenRules with admin)
  holdingCid <- submit admin $ createCmd (Token with holding = adminHolding)
  now <- getTime

  let cliffSchedule =
        [ mkLegSide swapuser "cliff-day-30"  400.0 instrumentIdText
        , mkLegSide swapuser "linear-day-45" 200.0 instrumentIdText
        , mkLegSide swapuser "linear-day-60" 400.0 instrumentIdText
        ]
      spec = Alloc.AllocationSpecification with
        admin = admin
        authorizer = adminAccount
        transferLegSides = cliffSchedule
        settlementDeadline = Some (now `addRelTime` days 90)
        nextIterationFunding = None
        committed = True
        meta = Meta.emptyMetadata
      settlementInfo = Alloc.SettlementInfo with
        executors = [admin]
        id = "v2-cliff-stream-settle"
        cid = None
        meta = Meta.emptyMetadata
      factoryCid = toInterfaceContractId @AInstr.AllocationFactory rulesCid
      rulesAnyCid : ContractId Meta.AnyContract = coerceContractId rulesCid
      tokenRulesCtx = TextMap.fromList
        [ ("testTokenV2/tokenRules", Meta.AV_ContractId rulesAnyCid) ]

  debug "=== create cliff allocation ==="
  result <- submit admin $ exerciseCmd factoryCid AInstr.AllocationFactory_Allocate with
    settlement = settlementInfo
    allocation = spec
    requestedAt = now
    inputHoldingCids = [toInterfaceContractId @V2.Holding holdingCid]
    extraArgs = Meta.ExtraArgs with
      context = Meta.ChoiceContext with values = tokenRulesCtx
      meta = Meta.emptyMetadata
    actors = [admin]

  case result.output of
    AInstr.AllocationInstructionResult_Completed allocCid -> do
      debug ("Cliff allocation cid: " <> show allocCid)
      settleCliffAllocation allocCid rulesCid
    _ -> abort ("Allocation creation failed: " <> show result.output)
