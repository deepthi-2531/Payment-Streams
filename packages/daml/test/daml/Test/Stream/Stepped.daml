-- | Tests for stepped vesting mode.
--
-- Covers: withdraw between steps (gets 0 new), withdraw at step boundary,
-- partial step periods, all steps completed, cancel mid-step.
module Test.Stream.Stepped where

import Daml.Script
import DA.Time (days, time)
import DA.Date (date, Month(..))
import DA.List (head)

import CantonStreams.Interface.Types
import CantonStreams.Interface.Stream (WithdrawResult(..), CancelResult(..))
import CantonStreams.Stream.Escrow
import CantonStreams.Stream.Accrual
import CantonStreams.Settlement.Adapter (EscrowBalance(..))

-- | Helper: create a stepped stream via direct contract creation.
-- stepInterval in days, amountPerStep is the fixed amount per step.
createSteppedStream : Party -> Party -> StreamId -> Time -> Time -> Int -> Decimal -> Decimal -> Bool -> Script (ContractId StreamEscrow)
createSteppedStream sender recipient sid start end intervalDays amtPerStep deposit cancellable = do
  let cfg = StreamConfig with
        streamId = sid
        sender
        recipient
        totalDeposited = deposit
        startTime = start
        endTime = end
        vestingMode = Stepped with
          stepInterval = days intervalDays
          amountPerStep = amtPerStep
        assetType = LocalToken
        instrumentRef = None
        cancellable
        settlementMode = None
  submitMulti [sender, recipient] [] do
    createCmd StreamEscrow with
      config = cfg
      state = initialStreamState
      escrow = EscrowBalance with amount = deposit; owner = sender
      observers = []

-- | Test: withdraw between steps returns nothing new.
testSteppedBetweenSteps : Script ()
testSteppedBetweenSteps = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  -- 10 steps of 1000 each, every 30 days, total 10000
  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30

  setTime start
  escrowCid <- createSteppedStream alice bob "step-between" start end intervalDays amtPerStep deposit True

  -- Withdraw at day 15 (between step 0 and step 1): should fail since 0 accrued
  let day15 = time (date 2025 Jan 16) 0 0 0
  setTime day15
  submitMustFail bob do
    exerciseCmd escrowCid Withdraw_Stream with withdrawTime = day15

  let accrued = steppedAccrual deposit start (days intervalDays) amtPerStep day15
  debug ("GOLDEN:stepped_between:accrued_day15:" <> show accrued)
  -- At day 15, floor(15/30) = 0 steps, so accrued = 0
  assertMsg "No accrual between steps" (accrued == 0.0)

-- | Test: withdraw at step boundary unlocks one step.
testSteppedAtBoundary : Script ()
testSteppedAtBoundary = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30
      -- Step 1 boundary: 30 days after start
      step1 = time (date 2025 Jan 31) 0 0 0

  setTime start
  escrowCid <- createSteppedStream alice bob "step-boundary" start end intervalDays amtPerStep deposit True

  setTime step1
  result <- submit bob do
    exerciseCmd escrowCid Withdraw_Stream with withdrawTime = step1

  let expectedAccrued = steppedAccrual deposit start (days intervalDays) amtPerStep step1

  debug ("GOLDEN:stepped_boundary:accrued:" <> show expectedAccrued)
  debug ("GOLDEN:stepped_boundary:withdrawn:" <> show result.amountWithdrawn)

  assertMsg "One step unlocked at boundary" (result.amountWithdrawn == expectedAccrued)
  assertMsg "Status Active" (result.newStatus == Active)

-- | Test: withdraw at multiple step boundaries.
testSteppedMultipleSteps : Script ()
testSteppedMultipleSteps = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30
      -- After 3 steps: 90 days
      after3Steps = time (date 2025 Apr 1) 0 0 0

  setTime start
  escrowCid <- createSteppedStream alice bob "step-multi" start end intervalDays amtPerStep deposit True

  setTime after3Steps
  result <- submit bob do
    exerciseCmd escrowCid Withdraw_Stream with withdrawTime = after3Steps

  let expectedAccrued = steppedAccrual deposit start (days intervalDays) amtPerStep after3Steps

  debug ("GOLDEN:stepped_multi:accrued:" <> show expectedAccrued)
  debug ("GOLDEN:stepped_multi:withdrawn:" <> show result.amountWithdrawn)

  assertMsg "Three steps unlocked" (result.amountWithdrawn == expectedAccrued)

-- | Test: withdraw between steps after prior withdrawal gets 0 new.
testSteppedNothingNewBetween : Script ()
testSteppedNothingNewBetween = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30
      step1 = time (date 2025 Jan 31) 0 0 0
      betweenSteps = time (date 2025 Feb 15) 0 0 0

  setTime start
  escrowCid <- createSteppedStream alice bob "step-nothing" start end intervalDays amtPerStep deposit True

  -- Withdraw at step 1
  setTime step1
  r1 <- submit bob do
    exerciseCmd escrowCid Withdraw_Stream with withdrawTime = step1

  -- Try to withdraw between step 1 and step 2 — should fail
  escrows <- query @StreamEscrow bob
  let (cid2, _) = head escrows

  setTime betweenSteps
  submitMustFail bob do
    exerciseCmd cid2 Withdraw_Stream with withdrawTime = betweenSteps

  debug ("GOLDEN:stepped_nothing_new:step1_withdrawn:" <> show r1.amountWithdrawn)

-- | Test: all steps completed — full deposit withdrawn.
testSteppedAllCompleted : Script ()
testSteppedAllCompleted = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30
      -- 10 steps * 30 days = 300 days after start
      afterAllSteps = time (date 2025 Oct 28) 0 0 0

  setTime start
  escrowCid <- createSteppedStream alice bob "step-all" start end intervalDays amtPerStep deposit True

  setTime afterAllSteps
  result <- submit bob do
    exerciseCmd escrowCid Withdraw_Stream with withdrawTime = afterAllSteps

  let expectedAccrued = steppedAccrual deposit start (days intervalDays) amtPerStep afterAllSteps

  debug ("GOLDEN:stepped_all:accrued:" <> show expectedAccrued)
  debug ("GOLDEN:stepped_all:withdrawn:" <> show result.amountWithdrawn)
  debug ("GOLDEN:stepped_all:status:" <> show result.newStatus)

  assertMsg "Full deposit withdrawn" (result.amountWithdrawn == deposit)
  assertMsg "Status Completed" (result.newStatus == Completed)

-- | Test: cancel mid-step returns correct pro-rata split.
testSteppedCancel : Script ()
testSteppedCancel = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30
      -- Cancel after 2 full steps + 15 days into step 3
      cancelAt = time (date 2025 Mar 17) 0 0 0

  setTime start
  escrowCid <- createSteppedStream alice bob "step-cancel" start end intervalDays amtPerStep deposit True

  setTime cancelAt
  result <- submit alice do
    exerciseCmd escrowCid Cancel_Stream with cancelTime = cancelAt

  let expectedAccrued = steppedAccrual deposit start (days intervalDays) amtPerStep cancelAt
      expectedRefund = refundable deposit expectedAccrued

  debug ("GOLDEN:stepped_cancel:accrued:" <> show expectedAccrued)
  debug ("GOLDEN:stepped_cancel:recipientAmount:" <> show result.recipientAmount)
  debug ("GOLDEN:stepped_cancel:senderRefund:" <> show result.senderRefund)

  assertMsg "Recipient gets stepped accrual" (result.recipientAmount == expectedAccrued)
  assertMsg "Sender gets refund" (result.senderRefund == expectedRefund)

-- | Test: partial step period — verify floor behavior.
testSteppedPartialPeriod : Script ()
testSteppedPartialPeriod = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Nov 1) 0 0 0
      deposit = 10000.0
      amtPerStep = 1000.0
      intervalDays = 30
      -- 45 days in: floor(45/30) = 1 step
      day45 = time (date 2025 Feb 15) 0 0 0

  setTime start
  escrowCid <- createSteppedStream alice bob "step-partial" start end intervalDays amtPerStep deposit True

  setTime day45
  result <- submit bob do
    exerciseCmd escrowCid Withdraw_Stream with withdrawTime = day45

  let expectedAccrued = steppedAccrual deposit start (days intervalDays) amtPerStep day45

  debug ("GOLDEN:stepped_partial:accrued:" <> show expectedAccrued)
  debug ("GOLDEN:stepped_partial:withdrawn:" <> show result.amountWithdrawn)

  -- floor(45 days / 30 days) = 1 step = 1000
  assertMsg "Partial period floors to 1 step" (result.amountWithdrawn == expectedAccrued)
