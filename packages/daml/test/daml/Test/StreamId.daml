-- | Tests for stream ID uniqueness and multiple streams between same parties.
--
-- Covers: multiple streams between same parties with different streamIds,
-- uniqueness enforcement via contract keys, key lookup.
module Test.StreamId where

import Daml.Script
import DA.Time (days, time)
import DA.Date (date, Month(..))
import DA.List (head)

import CantonStreams.Interface.Types
import CantonStreams.Interface.Stream (WithdrawResult(..))
import CantonStreams.Stream.Escrow
import CantonStreams.Settlement.Adapter (EscrowBalance(..))

-- | Helper: create a linear stream via direct contract creation.
createStream : Party -> Party -> StreamId -> Time -> Time -> Decimal -> Script (ContractId StreamEscrow)
createStream sender recipient sid start end deposit = do
  let cfg = StreamConfig with
        streamId = sid
        sender
        recipient
        totalDeposited = deposit
        startTime = start
        endTime = end
        vestingMode = Linear
        assetType = LocalToken
        instrumentRef = None
        cancellable = True
        settlementMode = None
  submitMulti [sender, recipient] [] do
    createCmd StreamEscrow with
      config = cfg
      state = initialStreamState
      escrow = EscrowBalance with amount = deposit; owner = sender
      observers = []

-- | Test: multiple streams between same sender and recipient with different IDs.
testMultipleStreamsSameParties : Script ()
testMultipleStreamsSameParties = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Jul 1) 0 0 0

  setTime start

  -- Create 3 streams between same parties with different IDs
  cid1 <- createStream alice bob "stream-alpha" start end 10000.0
  cid2 <- createStream alice bob "stream-beta" start end 20000.0
  cid3 <- createStream alice bob "stream-gamma" start end 30000.0

  -- All 3 should be queryable
  escrows <- query @StreamEscrow bob
  assertMsg "Should have 3 streams" (length escrows == 3)

  -- Verify each has correct deposit
  let deposits = map (\(_, e) -> e.config.totalDeposited) escrows
      ids = map (\(_, e) -> e.config.streamId) escrows

  assertMsg "All 3 IDs are distinct" (length ids == 3)

  debug ("GOLDEN:multi_stream:count:" <> show (length escrows))
  debug ("GOLDEN:multi_stream:ids:" <> show ids)

-- | Test: raw template creation permits duplicate stream ids because this
-- package's Daml LF target does not support contract keys. The SDK/proxy
-- create workflow is responsible for sender-scoped duplicate rejection.
testDuplicateStreamIdRejected : Script ()
testDuplicateStreamIdRejected = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Jul 1) 0 0 0

  setTime start

  -- Create first stream
  cid1 <- createStream alice bob "duplicate-id" start end 10000.0

  -- Raw template creation cannot enforce sender-scoped uniqueness without
  -- contract keys, so this succeeds. Off-ledger create flows must reject it.
  let cfg = StreamConfig with
        streamId = "duplicate-id"
        sender = alice
        recipient = bob
        totalDeposited = 5000.0
        startTime = start
        endTime = end
        vestingMode = Linear
        assetType = LocalToken
        instrumentRef = None
        cancellable = True
        settlementMode = None

  submitMulti [alice, bob] [] do
    createCmd StreamEscrow with
      config = cfg
      state = initialStreamState
      escrow = EscrowBalance with amount = 5000.0; owner = alice
      observers = []

  escrows <- query @StreamEscrow alice
  let matches = filter (\(_, e) -> e.config.streamId == "duplicate-id" && e.config.sender == alice) escrows
  assertMsg "Raw template permits duplicate sender-scoped stream ids" (length matches == 2)

-- | Test: same streamId but different senders is allowed (key is (sender, streamId)).
testSameIdDifferentSenders : Script ()
testSameIdDifferentSenders = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Jul 1) 0 0 0

  setTime start

  -- Alice -> Bob with ID "shared-id"
  cid1 <- createStream alice bob "shared-id" start end 10000.0

  -- Charlie -> Bob with same ID "shared-id" — should succeed (different sender)
  cid2 <- createStream charlie bob "shared-id" start end 8000.0

  -- Both should exist
  escrowsBob <- query @StreamEscrow bob
  assertMsg "Bob sees 2 streams" (length escrowsBob == 2)

  debug ("GOLDEN:same_id_diff_sender:count:" <> show (length escrowsBob))

-- | Test: lookup by contract key (sender, streamId).
-- | Test: contract-key lookup by (sender, streamId).
--
-- DISABLED: Contract keys are not supported in Daml LF 2.x (SDK 3.4+),
-- and `StreamEscrow` no longer declares a key. The test is preserved as
-- a stub so the file builds; lookup by streamId is now exercised via
-- query-and-filter (see `testStreamIdUniqueness` below).
testKeyLookup : Script ()
testKeyLookup = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Jul 1) 0 0 0

  setTime start

  cid <- createStream alice bob "lookup-test" start end 12000.0

  -- Filter-based lookup replaces the deprecated queryContractKey path.
  escrows <- query @StreamEscrow alice
  let matches = filter (\(_, e) -> e.config.streamId == "lookup-test") escrows
  assertMsg "streamId-filter lookup found contract" (length matches == 1)

  let noMatches = filter (\(_, e) -> e.config.streamId == "nonexistent-id") escrows
  assertMsg "streamId-filter for missing id returns empty" (null noMatches)

  debug "GOLDEN:key_lookup:found=True"

-- | Test: multiple streams with independent lifecycle.
testMultipleStreamsIndependentLifecycle : Script ()
testMultipleStreamsIndependentLifecycle = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Jul 1) 0 0 0
      midpoint = time (date 2025 Apr 1) 0 0 0

  setTime start

  cid1 <- createStream alice bob "indep-1" start end 10000.0
  cid2 <- createStream alice bob "indep-2" start end 20000.0
  cid3 <- createStream alice bob "indep-3" start end 30000.0

  -- Withdraw from stream 1 only
  setTime midpoint
  r1 <- submit bob do
    exerciseCmd cid1 Withdraw_Stream with withdrawTime = midpoint

  -- Cancel stream 2
  submit alice do
    exerciseCmd cid2 Cancel_Stream with cancelTime = midpoint

  -- Stream 3 remains untouched — verify it is still Active
  escrows <- query @StreamEscrow bob
  -- After withdraw on stream 1: new contract created (Active or Completed)
  -- After cancel on stream 2: new contract created (Cancelled)
  -- Stream 3: unchanged (Active)
  let activeEscrows = filter (\(_, e) -> e.state.status == Active) escrows
      cancelledEscrows = filter (\(_, e) -> e.state.status == Cancelled) escrows

  -- Stream 1 should still be Active (partial withdraw), stream 3 Active, stream 2 Cancelled
  assertMsg "2 Active streams remain" (length activeEscrows == 2)
  assertMsg "1 Cancelled stream" (length cancelledEscrows == 1)

  debug ("GOLDEN:independent:active:" <> show (length activeEscrows))
  debug ("GOLDEN:independent:cancelled:" <> show (length cancelledEscrows))

-- | Test: different recipients from same sender.
testDifferentRecipientsSameSender : Script ()
testDifferentRecipientsSameSender = script do
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"
  diana <- allocateParty "Diana"

  let start = time (date 2025 Jan 1) 0 0 0
      end   = time (date 2025 Jul 1) 0 0 0

  setTime start

  cid1 <- createStream alice bob "payroll-bob" start end 10000.0
  cid2 <- createStream alice charlie "payroll-charlie" start end 12000.0
  cid3 <- createStream alice diana "payroll-diana" start end 15000.0

  -- Alice should see all 3
  escrowsAlice <- query @StreamEscrow alice
  assertMsg "Alice sees 3 streams" (length escrowsAlice == 3)

  -- Each recipient should see only 1
  escrowsBob <- query @StreamEscrow bob
  escrowsCharlie <- query @StreamEscrow charlie
  escrowsDiana <- query @StreamEscrow diana
  assertMsg "Bob sees 1" (length escrowsBob == 1)
  assertMsg "Charlie sees 1" (length escrowsCharlie == 1)
  assertMsg "Diana sees 1" (length escrowsDiana == 1)

  debug ("GOLDEN:diff_recipients:alice_count:" <> show (length escrowsAlice))

-- | Helper: check if Optional is Some.
isSome : Optional a -> Bool
isSome (Some _) = True
isSome None = False

-- | Helper: check if Optional is None.
isNone : Optional a -> Bool
isNone None = True
isNone (Some _) = False
