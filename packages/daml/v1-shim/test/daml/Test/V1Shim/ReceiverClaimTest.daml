-- | Tests for `ReceiverClaimV1`: sender signs once at setup, then
-- receiver+executor claim the bound V1 allocation later.
module Test.V1Shim.ReceiverClaimTest where

import DA.Assert ((===))
import DA.Time
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import qualified Splice.Api.Token.AllocationV1 as A1

import CantonStreams.V1Shim.ReceiverClaim

template MockAllocation
  with
    allocation : A1.AllocationSpecification
  where
    signatory
      allocation.transferLeg.sender,
      allocation.transferLeg.receiver,
      allocation.settlement.executor

    interface instance A1.Allocation for MockAllocation where
      view = A1.AllocationView with
        allocation
        holdingCids = []
        meta = emptyMetadata

      allocation_executeTransferImpl _self _arg =
        pure A1.Allocation_ExecuteTransferResult with
          senderHoldingCids = []
          receiverHoldingCids = []
          meta = emptyMetadata

      allocation_cancelImpl _self _arg =
        pure A1.Allocation_CancelResult with
          senderHoldingCids = []
          meta = emptyMetadata

      allocation_withdrawImpl _self _arg =
        pure A1.Allocation_WithdrawResult with
          senderHoldingCids = []
          meta = emptyMetadata

data ClaimFixture = ClaimFixture with
  sender : Party
  recipient : Party
  executor : Party
  allocationCid : ContractId MockAllocation
  claimCid : ContractId ReceiverClaimV1

emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with
  context = emptyChoiceContext
  meta = emptyMetadata

setupClaim : RelTime -> Script ClaimFixture
setupClaim unlockOffset = do
  sender <- allocateParty "ClaimSender"
  recipient <- allocateParty "ClaimRecipient"
  executor <- allocateParty "ClaimExecutor"
  now <- getTime
  let ref = "stream-claim-001:cycle-1"
      amount = 12.5
      leg = A1.TransferLeg with
        sender
        receiver = recipient
        amount
        instrumentId = InstrumentId with admin = executor, id = "Amulet"
        meta = emptyMetadata
      settlement = A1.SettlementInfo with
        executor
        settlementRef = A1.Reference with id = ref, cid = None
        requestedAt = now
        allocateBefore = addRelTime now (minutes 10)
        settleBefore = addRelTime now (minutes 20)
        meta = emptyMetadata
      allocation = A1.AllocationSpecification with
        settlement
        transferLegId = "leg-1"
        transferLeg = leg

  allocationCid <- submitMulti [sender, recipient, executor] [] do
    createCmd MockAllocation with allocation

  let allocationIfaceCid = toInterfaceContractId @A1.Allocation allocationCid
  claimCid <- submit sender do
    createCmd ReceiverClaimV1 with
      streamId = "stream-claim-001"
      cycle = 1
      sender
      recipient
      executor
      allocationCid = allocationIfaceCid
      expectedSettlementRef = ref
      amount
      unlockAt = addRelTime now unlockOffset
      expiresAt = addRelTime now (minutes 30)
      meta = emptyMetadata

  pure ClaimFixture with sender, recipient, executor, allocationCid, claimCid

-- | The product requirement: sender signs once when the claim contract is
-- created; later only recipient + executor submit the claim transaction.
test_receiverAndExecutorCanClaimAfterSenderSetupConsent : Script ()
test_receiverAndExecutorCanClaimAfterSenderSetupConsent = do
  f <- setupClaim (seconds (-1))
  _ <- submitMulti [f.recipient, f.executor] [] do
    exerciseCmd f.claimCid Claim with
      extraArgs = emptyExtraArgs
  remaining <- query @MockAllocation f.sender
  remaining === []

-- | Recipient alone is not enough: the executor is still the settlement
-- authority and time gate.
test_receiverAloneCannotClaim : Script ()
test_receiverAloneCannotClaim = do
  f <- setupClaim (seconds (-1))
  submitMustFail f.recipient do
    exerciseCmd f.claimCid Claim with
      extraArgs = emptyExtraArgs

-- | The on-ledger policy enforces the unlock time.
test_claimBeforeUnlockFails : Script ()
test_claimBeforeUnlockFails = do
  f <- setupClaim (minutes 10)
  submitMultiMustFail [f.recipient, f.executor] [] do
    exerciseCmd f.claimCid Claim with
      extraArgs = emptyExtraArgs

-- | Sender reclaim uses V1 Allocation_Withdraw, so it does not need receiver
-- or executor authorization.
test_senderCanWithdrawUnclaimedAllocation : Script ()
test_senderCanWithdrawUnclaimedAllocation = do
  f <- setupClaim (minutes 10)
  _ <- submit f.sender do
    exerciseCmd f.claimCid SenderWithdraw with
      extraArgs = emptyExtraArgs
  remaining <- query @MockAllocation f.sender
  remaining === []
