-- | Transitional CIP-56 V1 allocation-request shim.
--
-- `StreamAllocationRequestV1` is a thin on-ledger carrier for the V1
-- `Splice.Api.Token.AllocationRequestV1.AllocationRequest` interface, so
-- V1 wallets (today's CC / Amulet and USDCx clients) can discover a
-- stream's per-cycle settlement request and allocate against it.
--
-- Why a separate package from `canton-streams` (main):
--
--   1. The main package hash stays stable — the Milestone-1 template
--      manifest pins it, and adoption metrics filter on it.
--   2. Retiring the V1 lane is a deployment decision: stop uploading
--      this DAR. No main-package code changes.
--
-- ## Lifecycle (one cycle per withdrawal — V1 has no iteration)
--
--   1. The stream operator (or sender's automation) creates a
--      `StreamAllocationRequestV1` for the current withdrawal cycle,
--      with `settlementRef.id` carrying `<streamId>:<cycle>` so the
--      off-ledger executor can correlate it to the stream contract.
--   2. The sender's wallet sees the request (senders + receivers are
--      observers per the interface spec) and creates a V1 `Allocation`
--      via the registry's AllocationFactory.
--   3. The executor exercises `Allocation_ExecuteTransfer` on the
--      registry's Allocation. NOTE: that choice is controlled by
--      executor AND sender AND receiver jointly. Off-ledger submission
--      therefore needs all three in `actAs` (workable when the parties
--      are co-hosted, e.g. DevNet probes), or the exercise must be
--      composed inside a choice on a contract signed by those parties
--      (the production pattern; see the stream workflow contracts).
--   4. The executor archives this request via `AllocationRequest_Withdraw`
--      (interface, executor-controlled) or `ShimArchive` (native,
--      requester-controlled) once the cycle settles or expires.
--
-- DEPLOYMENT NOTE: the V1 interface packages this shim implements are
-- already vetted on DevNet/TestNet/MainNet participants (Amulet
-- implements them). Before uploading the shim, verify the locally
-- fetched interface DARs in `../main/.lib/` match the on-ledger package
-- ids — a mismatched interface package id means wallets will not see
-- the request.
--
-- @deprecated from birth — retired together with the SDK's V1 lane once
-- CC / USDCx advertise CIP-56 V2 (see "V1 lane retirement" in CHANGELOG).
module CantonStreams.V1Shim.AllocationRequestShim where

import DA.TextMap (TextMap)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV1
import qualified Splice.Api.Token.AllocationRequestV1 as AR1

-- | All parties on either side of any transfer leg.
legParties : TextMap TransferLeg -> [Party]
legParties legs = concatMap (\leg -> [leg.sender, leg.receiver]) (map snd (TextMap.toList legs))

-- | Senders of the transfer legs (the parties whose wallets must allocate).
legSenders : TextMap TransferLeg -> [Party]
legSenders legs = map ((.sender) . snd) (TextMap.toList legs)

-- | Per-cycle V1 allocation request for a payment stream.
--
-- Created fresh for every withdrawal cycle; archived on settle, reject,
-- withdraw, or expiry. Carries no funds — custody lives in the
-- registry's V1 `Allocation` contracts.
template StreamAllocationRequestV1
  with
    requestedBy : Party
      -- ^ The stream operator (or sender automation) proposing this
      -- settlement cycle. Sole signatory: the request is a proposal;
      -- consent to move funds is expressed by the sender's wallet
      -- creating the matching Allocation.
    settlement : SettlementInfo
      -- ^ V1 settlement coordinates. `settlementRef.id` SHOULD be
      -- `<streamId>:<cycle>` for off-ledger correlation.
    transferLegs : TextMap TransferLeg
      -- ^ Requested legs, keyed by leg id. Single-leg for plain
      -- withdrawals; multi-leg for cancel (accrued + refund).
    meta : Metadata
      -- ^ Extensibility metadata (mirrors the interface view).
  where
    signatory requestedBy
    -- Per the interface spec, at least all leg senders must be
    -- observers so their wallets can show the request. We add the
    -- receivers and the executor for symmetric visibility.
    observer legParties transferLegs, [settlement.executor]

    -- | Native cleanup for the requester (e.g. cycle superseded before
    -- any wallet allocated). The interface offers executor-controlled
    -- `AllocationRequest_Withdraw` and sender-controlled
    -- `AllocationRequest_Reject`; this covers the requester itself.
    choice ShimArchive : ()
      controller requestedBy
      do pure ()

    interface instance AR1.AllocationRequest for StreamAllocationRequestV1 where
      view = AR1.AllocationRequestView with
        settlement
        transferLegs
        meta

      allocationRequest_RejectImpl _self arg = do
        -- Spec: any sender of a transfer leg may reject, signalling it
        -- will not allocate. Consuming: the request archives.
        assertMsg
          "AllocationRequest_Reject: actor must be a sender of a transfer leg"
          (arg.actor `elem` legSenders transferLegs)
        pure ChoiceExecutionMetadata with meta = emptyMetadata

      allocationRequest_WithdrawImpl _self _arg =
        -- Executor-controlled per the interface (controller is
        -- `settlement.executor`). Consuming: the request archives.
        pure ChoiceExecutionMetadata with meta = emptyMetadata
