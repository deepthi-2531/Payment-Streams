-- | Transitional CIP-0047 FeaturedAppActivity integration for Canton
-- Payment Streams.
--
-- This module is the **integration seam** between Canton Payment Streams'
-- lifecycle events (Create, Accept, Withdraw, Cancel, Renew, TopUp,
-- Complete) and a network featured-app marker program.
--
-- ## Why this matters
--
-- CIP-0047 introduces `FeaturedAppActivityMarker` contracts that
-- registered featured-app providers emit to signal that a transaction
-- added value to the network.
--
-- This module deliberately does NOT encode reward economics. CIP-0047
-- is expected to be phased out when CIP-0104 goes live, and the active
-- reward regime is network- and time-dependent. Treat this as an
-- optional marker-emission seam, not as a budgeting primitive.
--
-- ## Integration model
--
-- The actual `FeaturedAppActivityMarker` template is published by the
-- relevant network program as part of the CIP-0047 standard. Until that
-- template is depended on directly in `.lib/`, this module defines an
-- **integration record** `FeaturedAppEmission` that captures what
-- would be emitted, and a helper function `buildEmission` that
-- consumers can wire into their settlement orchestrator.
--
-- When the upstream CIP-0047 DAR is added to `.lib/`, replace the
-- integration record with the real `FeaturedAppActivityMarker.Create`
-- invocation. The consumer surface (the `FeaturedAppEmission` record
-- + opt-in config field) does not change.
module CantonStreams.FeaturedApp.Activity where

------------------------------------------------------------------------
-- Activity emission record
------------------------------------------------------------------------

-- | One emission record per stream lifecycle event. Each event a
-- consumer marks as featured-app activity produces one of these and
-- (in production) drives the creation of a `FeaturedAppActivityMarker`
-- contract.
--
-- Fields:
--
--   featuredAppKey   — the dApp's CIP-0047 featured-app key (issued
--                      by the program administrator upon registration)
--   activityType     — which lifecycle event triggered the emission
--   amount           — economic value associated with the event,
--                      used by the active reward regime, if any
--   streamId         — Canton Payment Streams stream id for audit
--   participant      — the party performing the action (sender,
--                      recipient, executor, depending on activityType)
--   meta             — optional free-form audit metadata
data FeaturedAppEmission = FeaturedAppEmission with
    featuredAppKey : Text
    activityType : ActivityType
    amount : Decimal
    streamId : Text
    participant : Party
    meta : Optional Text
  deriving (Eq, Show)

-- | Lifecycle event categories that produce featured-app emissions.
-- One emission per category per execution.
data ActivityType
  = ActivityCreate
  | ActivityAccept
  | ActivityWithdraw
  | ActivityCancel
  | ActivityRenew
  | ActivityTopUp
  | ActivityComplete
  | ActivityMilestoneConfirm
  deriving (Eq, Show)

------------------------------------------------------------------------
-- Per-stream opt-in configuration
------------------------------------------------------------------------

-- | Per-stream featured-app configuration. Embedded in `StreamConfig`
-- (or carried alongside it) to determine whether to emit markers on
-- each lifecycle event.
--
-- `enabled = False` is the default — adopters explicitly opt in by
-- supplying their featured-app key.
data FeaturedAppConfig = FeaturedAppConfig with
    enabled : Bool
    featuredAppKey : Text
      -- ^ Empty string if `enabled = False`
  deriving (Eq, Show)

-- | Default config — featured-app marker emission disabled.
disabledFeaturedApp : FeaturedAppConfig
disabledFeaturedApp = FeaturedAppConfig with
  enabled = False
  featuredAppKey = ""

-- | Build a config for a registered featured-app key.
enabledFeaturedApp : Text -> FeaturedAppConfig
enabledFeaturedApp key = FeaturedAppConfig with
  enabled = True
  featuredAppKey = key

------------------------------------------------------------------------
-- Recording seam for real CIP-0047 marker creation
------------------------------------------------------------------------

-- | Build a `FeaturedAppEmission` record from a stream lifecycle event.
--
-- Returns `None` if the stream's `FeaturedAppConfig` has emission
-- disabled. Returns `Some emission` if the consumer should drive an
-- actual `FeaturedAppActivityMarker.Create` against it.
--
-- This is intentionally a pure function so it can be called from any
-- context (settlement orchestrator, choice body, off-chain SDK). The
-- actual marker creation is performed by the settlement layer where
-- it has the right authority + can package the marker into the
-- transaction.
buildEmission
  : FeaturedAppConfig
  -> ActivityType
  -> Decimal
  -> Text          -- ^ streamId
  -> Party         -- ^ participant
  -> Optional Text -- ^ meta
  -> Optional FeaturedAppEmission
buildEmission cfg activityType amount streamId participant meta =
  if cfg.enabled
  then Some FeaturedAppEmission with
    featuredAppKey = cfg.featuredAppKey
    activityType
    amount
    streamId
    participant
    meta
  else None

-- | Default amount associated with each activity type, used when the
-- caller doesn't supply a more specific amount. Consumers SHOULD pass
-- the actual economic value where the active marker regime needs it
-- (e.g. amount transferred on a Withdraw); the defaults here are only a
-- neutral safety net.
defaultActivityAmount : ActivityType -> Decimal
defaultActivityAmount activityType = case activityType of
  ActivityCreate -> 0.0   -- creation events typically don't earn rewards (no value transferred yet)
  ActivityAccept -> 0.0
  ActivityWithdraw -> 0.0
  ActivityCancel -> 0.0
  ActivityRenew -> 0.0
  ActivityTopUp -> 0.0
  ActivityComplete -> 0.0
  ActivityMilestoneConfirm -> 0.0
