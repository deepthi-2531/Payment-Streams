{
  "name": "@canton-streams/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Canton Payment Streams — gRPC-first continuous payment streaming",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "canton",
    "daml",
    "sdk",
    "payment-streams",
    "streaming-payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepthi-2531/Payment-Streams.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/deepthi-2531/Payment-Streams#readme",
  "bugs": {
    "url": "https://github.com/deepthi-2531/Payment-Streams/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.7.15",
    "decimal.js": "10.6.0",
    "zod": "4.3.6",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "@types/node": "22.14.0"
  }
}
