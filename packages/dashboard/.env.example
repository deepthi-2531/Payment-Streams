# Canton Streams Dashboard — dev environment template
#
# Copy this file to `.env.local` and customize. `.env.local` is
# gitignored; never commit secrets here or in any .env.* file.
#
# All VITE_* variables are exposed to the browser bundle.
# Do not put secrets in VITE_* variables — anything you put here ends
# up in the shipped JS.

# Auto-select the remote SWK wallet without showing the picker UI.
# Useful for local dev / single-wallet environments.
# Default: unset (picker UI shown normally).
# VITE_SKIP_WALLET_PICKER=true

# CIP-103 wallet-gateway URL. The dapp-sdk defaults to
# http://localhost:3030/api/v0/dapp; override if your gateway lives
# elsewhere or you've changed the SWK config path.
# VITE_WALLET_GATEWAY_URL=http://localhost:3030/api/v0/dapp

# Display name for the configured remote wallet in skip-picker mode.
# VITE_WALLET_NAME=Splice Amulet Wallet (LocalNet V2)

# WalletConnect / Reown project id. Required only if you want the
# picker to expose the WalletConnect adapter. Get one from
# https://cloud.reown.com (formerly WalletConnect Cloud). The bundled
# @walletconnect/sign-client peer dep also needs to be installed; see
# packages/dashboard/vite.config.ts for the current stub setup.
# VITE_WC_PROJECT_ID=
