# Canton sandbox participant node for the local Streams stack.
#
# The old image path used unavailable pinned Docker Hub tags. This image
# installs DPM directly, fetches the Splice Token Standard V2 DARs, builds
# the Streams DARs, then starts a DPM Canton sandbox with those DARs loaded.

FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    openjdk-17-jdk-headless \
  && rm -rf /var/lib/apt/lists/*

ENV DPM_HOME=/opt/dpm
ENV DPM_SDK_VERSION=3.4.10
ENV PATH="${DPM_HOME}/bin:${PATH}"

# Pin the installer to a known-good revision instead of piping the live
# URL straight into a shell. We fetch the script, check its sha256 against
# the expected digest, then run it with the explicit version arg so it does
# not resolve the moving "latest" channel. Bump both when intentionally
# upgrading the installer.
ENV DPM_INSTALLER_SHA256=a58fe45abfe5a54669e8b6d784097b60e27bc098d1284643f6d9771675005d3b

RUN curl -sSL https://get.digitalasset.com/install/install.sh -o /tmp/dpm-install.sh \
  && echo "${DPM_INSTALLER_SHA256}  /tmp/dpm-install.sh" | sha256sum -c - \
  && sh /tmp/dpm-install.sh "${DPM_SDK_VERSION}" \
  && rm -f /tmp/dpm-install.sh \
  && dpm install "${DPM_SDK_VERSION}"

WORKDIR /build

COPY multi-package.yaml package.json ./
COPY scripts/fetch-v2-dars.mjs scripts/fetch-v2-dars.mjs
COPY packages/daml/ packages/daml/

RUN rm -rf packages/daml/*/.daml packages/daml/main/.lib
RUN node scripts/fetch-v2-dars.mjs --mode source-build
RUN cd packages/daml/interfaces && dpm build
RUN cd packages/daml/main && dpm build

RUN mkdir -p /canton/dars \
  && cp packages/daml/main/.daml/dist/*.dar /canton/dars/ \
  && cp packages/daml/interfaces/.daml/dist/*.dar /canton/dars/ \
  && cp packages/daml/main/.lib/*.dar /canton/dars/

COPY docker/canton-entrypoint.sh /canton/bin/canton-entrypoint.sh
RUN chmod +x /canton/bin/canton-entrypoint.sh

# Drop root. The sandbox only needs to read its DARs and write the data
# directory, so run it under an unprivileged account. Pre-create
# /canton/data (the compose volume mount point) and hand the paths the
# process writes to the streams user.
RUN groupadd --system --gid 10001 streams \
  && useradd --system --uid 10001 --gid streams --home-dir /canton streams \
  && mkdir -p /canton/data \
  && chown -R streams:streams /canton /build "${DPM_HOME}"
USER streams

EXPOSE 6865 10011

ENTRYPOINT ["/canton/bin/canton-entrypoint.sh"]
