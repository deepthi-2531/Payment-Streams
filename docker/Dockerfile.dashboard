# Multi-stage build for the Canton Streams dashboard

# Stage 1: Build
FROM node:22-alpine AS builder
RUN corepack enable pnpm

WORKDIR /app
ARG VITE_WALLET_GATEWAY_URL=http://localhost:3030/api/v0/dapp
ARG VITE_SKIP_WALLET_PICKER=false
ARG VITE_WALLET_NAME="Splice Amulet Wallet"
ENV VITE_WALLET_GATEWAY_URL=${VITE_WALLET_GATEWAY_URL}
ENV VITE_SKIP_WALLET_PICKER=${VITE_SKIP_WALLET_PICKER}
ENV VITE_WALLET_NAME=${VITE_WALLET_NAME}
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/sdk/package.json packages/sdk/
COPY packages/dashboard/package.json packages/dashboard/
RUN pnpm install --frozen-lockfile || pnpm install

COPY packages/sdk/ packages/sdk/
COPY packages/dashboard/ packages/dashboard/
COPY tsconfig.base.json ./

RUN pnpm --filter @canton-streams/sdk build
RUN pnpm --filter @canton-streams/dashboard build

# Stage 2: Serve with nginx
FROM nginx:alpine
COPY --from=builder /app/packages/dashboard/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
